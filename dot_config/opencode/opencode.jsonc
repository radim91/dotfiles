{
  "$schema": "https://opencode.ai/config.json",
  // Local llama-server instances on the Arc Pro B65.
  // Only one model fits in VRAM at a time; each has its own port so that
  // picking a model whose server is not running fails instead of silently
  // answering with the other model. Ports are kept out of the web-dev range.
  // The context limits must match the -c value in ~/.local/bin/llama-b65.
  "providers": {
    // Start with: llama-b65 qwen   (base model with thinking, for general questions)
    "llamacpp-qwen": {
      "name": "llama.cpp Qwen (B65)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18081/v1",
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (local)",
          "limit": { "context": 131072, "output": 8192 },
          "capabilities": { "tools": true },
        },
      
                "qwen3-8-27b": {
          "name": "Qwen3.8-27B (local)",
          "limit": { "context": 131072, "output": 8192 },
          "capabilities": { "tools": true },
        },
},
    },
    // Start with: llama-b65        (qwen-oc is the launcher default)
    // Same Qwen3.8-27B with the opencode LoRA adapter (harness-hub), thinking off.
    "llamacpp-qwen-oc": {
      "name": "llama.cpp Qwen + opencode adapter (B65)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18087/v1",
      },
      "models": {
        "qwen3.8-27b-opencode": {
          "name": "Qwen3.8-27B opencode-adapted (local)",
          "limit": { "context": 131072, "output": 8192 },
          "capabilities": { "tools": true },
        },
      
                "qwen3-8-27b-qwen-oc": {
          "name": "Qwen3.8-27B-UD-Q4_K_M (qwen-oc) (local)",
          "limit": { "context": 131072, "output": 8192 },
          "capabilities": { "tools": true },
        },
},
    },

    // Start with: llama-b65 inkling   (Inkling 2 Mini; reasoning always on, English only)
    "llamacpp-inkling": {
      "name": "llama.cpp Inkling 2 Mini (B65)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18088/v1",
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini UD-Q4_K_M (local)",
          "limit": { "context": 65536, "output": 16384 },
          "capabilities": { "tools": true },
        },
      },
    },

        "llamacpp-gemma-4-12b-it-q6-k": {
      "name": "llama.cpp gemma-4-12b-it-Q6_K (B65)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:18086/v1",
      },
      "models": {
        "gemma-4-12b-it-q6-k": {
          "name": "gemma-4-12b-it-Q6_K (local)",
          "limit": { "context": 32768, "output": 8192 },
          "capabilities": { "tools": true },
        },
      },
    },
},
  "model": "llamacpp-gemma-4-12b-it-q6-k/gemma-4-12b-it-q6-k",
  "mcp": {
    "servers": {
      "gimp": {
        "type": "local",
        "command": [
          "uvx",
          "gimp-mcp-plugin@latest"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/chromium",
          "--no-usage-statistics",
          "--no-performance-crux"
        ]
      }
    }
  },
  "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Deepseek v4.1 Flash",
      "options": {
        "baseURL": "https://llm.ai.e-infra.cz/v1"
      },
      "models": {
        "coder": {
          "name": "deepseek-v4.1-flash"
        },
        "thinker": {
          "name": "deepseek-v4.1-flash-thinking"
        }
      }
    }
}
