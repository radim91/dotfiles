#!/bin/sh
# egpu-b65 — run a command (default: steam) on the eGPU (Arc Pro B65, 8086:e222) only.
#
# Selection via environment, no namespaces/root (the old `unshare -rm` variant made
# Steam see uid 0 → "Cannot run as root user"; it also hardcoded renderD numbers,
# which shift after a TB hot-plug). Works for this process tree only; the desktop
# keeps running on the iGPU.
#
#   VK_LOADER_DRIVERS_SELECT  Vulkan loader loads only the Intel ANV ICD (no NVIDIA)
#   MESA_VK_DEVICE_SELECT     ...and of the Intel devices exposes only the B65 ("!" = only)
#   DRI_PRIME                 OpenGL (Mesa) renders on the B65
#   -u __NV_* / __GLX_*       drop PRIME-offload vars in case the caller set them
#
# Usage:
#   egpu-b65                        # start Steam on the B65
#   egpu-b65 steam steam://rungameid/12345
#   egpu-b65 some-native-game
#
# Note: if Steam is already running, quit it first — a new `steam` call would
# just forward to the running instance and the game would not get this environment.

[ $# -eq 0 ] && set steam

exec env \
  -u __NV_PRIME_RENDER_OFFLOAD \
  -u __GLX_VENDOR_LIBRARY_NAME \
  -u __VK_LAYER_NV_optimus \
  VK_LOADER_DRIVERS_SELECT='*intel_icd*' \
  MESA_VK_DEVICE_SELECT='8086:e222!' \
  DRI_PRIME='8086:e222' \
  "$@"
