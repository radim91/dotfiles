#!/bin/sh
# game-gpu — launch a game on the best GPU, automatically:
#   docked (Arc Pro B65 eGPU on TB present)  -> B65
#   undocked                                 -> internal NVIDIA RTX PRO 1000
#
# Steam launch option, set once per game:
#   /home/radim/.local/bin/game-gpu %command%
#
# Manual override (first argument or env var):
#   game-gpu b65 <game>       force the eGPU
#   game-gpu nvidia <game>    force the internal NVIDIA
#   GAME_GPU=nvidia game-gpu <game>
#
# How it works (deliberately no namespaces — Steam refuses to run as uid 0,
# which unshare -r would make you):
#   b65:    VK_ICD_FILENAMES hides the NVIDIA Vulkan driver, and
#           MESA_VK_DEVICE_SELECT=dgpu makes the B65 the first — and only
#           discrete — Vulkan device.
#   nvidia: standard NVIDIA PRIME offload env; the implicit
#           VK_LAYER_NV_optimus layer makes NVIDIA the first device.
# The iGPU may still be *visible* to Vulkan (second in the list); every
# common game-selection heuristic (first device / discrete / most VRAM)
# picks the intended GPU anyway.

[ "$1" = "b65" -o "$1" = "nvidia" ] && { target=$1; shift; }
target=${GAME_GPU:-$target}
[ $# -eq 0 ] && set steam
cmd=$1; shift

# eGPU PCI id (present on the bus = docked)
b65=0
for d in /sys/bus/pci/devices/*; do
  if [ "$(cat "$d/vendor" 2>/dev/null)" = "0x8086" ] && \
     [ "$(cat "$d/device" 2>/dev/null)" = "0xe222" ]; then
    b65=1
  fi
done

# pick: auto = B65 when docked, else NVIDIA
if [ -z "$target" ]; then
  if [ "$b65" = 1 ]; then target=b65; else target=nvidia; fi
fi
if [ "$target" = b65 ] && [ "$b65" != 1 ]; then
  echo "game-gpu: eGPU B65 not found (undocked?) — falling back to nvidia" >&2
  target=nvidia
fi

case "$target" in
  b65)
    exec env \
      VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/intel_icd.json \
      MESA_VK_DEVICE_SELECT=dgpu \
      "$cmd" "$@"
    ;;
  *)
    exec env \
      __NV_PRIME_RENDER_OFFLOAD=1 \
      __GLX_VENDOR_LIBRARY_NAME=nvidia \
      __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json \
      "$cmd" "$@"
    ;;
esac
