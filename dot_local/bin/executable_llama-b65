#!/usr/bin/env bash
# llama-server pinned to the Arc Pro B65 eGPU.
# Usage: llama-b65 [qwen|qwen-oc|medpsy|gemma|inkling|path/to/model.gguf] [extra llama-server args...]
#
# Backend and port are chosen per model (qwen measured 2026-11-19 on the B65).
# Ports are kept out of the usual web-dev range (3000/5173/8000/8080...):
#   qwen-oc (default) -> SYCL build, port 18087  (qwen + opencode LoRA adapter, thinking off)
#   qwen            -> SYCL build, port 18081  (base model with thinking; SYCL ~35 % faster than Vulkan)
#   medpsy          -> SYCL build, port 18085  (MedPsy-4B, medical Q&A, English only)
#   gemma           -> SYCL build, port 18086  (Gemma 4 12B, Czech transcript clean-up, thinking off)
#   inkling         -> Vulkan build, port 18088 (Inkling 2 Mini; ~7x faster than SYCL here, see the case)
# Any other .gguf path runs on Vulkan, port 18080. Override with BACKEND=sycl|vulkan.
set -euo pipefail

SRC="$HOME/src/llama.cpp"
MODELS="$HOME/models"

case "${1:-qwen-oc}" in
    qwen)  MODEL="$MODELS/Qwen3.8-27B-UD-Q4_K_M.gguf";    DEF_BACKEND=sycl;   PORT=18081
           CTX=131072  # hybrid SSM/attention model, KV cache tiny; native max is 262144
           SAMPLING=(--temp 1.0 --top-p 0.95 --top-k 20)
           # MTP head: 16 -> 36 tok/s on code generation (~79 % of drafted tokens accepted).
           # Disable with NO_MTP=1.
           MTP="$MODELS/MTP/mtp-Qwen3.8-27B-Q4_0.gguf"
           if [ -f "$MTP" ] && [ -z "${NO_MTP:-}" ]; then SAMPLING+=(--spec-type draft-mtp --spec-draft-model "$MTP"); fi ;;
    qwen-oc) MODEL="$MODELS/Qwen3.8-27B-UD-Q4_K_M.gguf";  DEF_BACKEND=sycl;   PORT=18087
           CTX=131072
           # harness-hub/Qwen3.8-27B-opencode-adapted: LoRA trained with RL for the opencode harness.
           # Thinking stays off (as trained; on adds ~6x tokens for no significant gain) and the
           # sampling is the training one. Trained on BF16 weights; on Q4_K_M it may drift.
           SAMPLING=(--temp 0.8 --top-p 1.0 --top-k 0
                     --lora "$MODELS/lora-qwen38-opencode/Qwen3.8-27B-opencode-lora-F16.gguf"
                     --reasoning off)
           MTP="$MODELS/MTP/mtp-Qwen3.8-27B-Q4_0.gguf"
           if [ -f "$MTP" ] && [ -z "${NO_MTP:-}" ]; then SAMPLING+=(--spec-type draft-mtp --spec-draft-model "$MTP"); fi ;;
    medpsy) MODEL="$MODELS/medpsy-4b-q8_0.gguf"; DEF_BACKEND=sycl; PORT=18085
           CTX=32768   # plain transformer (Qwen3-4B): KV ~150 KB/token, ~4.6 GiB at 32K (computed, not yet run on the B65)
           SAMPLING=(--temp 0.6 --top-p 0.95 --top-k 20) ;;  # as evaluated by the authors
    gemma) MODEL="$MODELS/gemma-4-12b-it-Q6_K.gguf"; DEF_BACKEND=sycl; PORT=18086
           CTX=32768
           # Rewriting Czech speech transcripts: low temperature, thinking off.
           # Measured 2026-11-21 on the B65: 34 tok/s without the MTP head, 81 tok/s with it.
           SAMPLING=(--temp 0.2 --reasoning off)
           MTP="$MODELS/MTP/mtp-gemma-4-12b-it.gguf"
           if [ -f "$MTP" ] && [ -z "${NO_MTP:-}" ]; then SAMPLING+=(--spec-type draft-mtp --spec-draft-model "$MTP"); fi ;;
    inkling) MODEL="$MODELS/Inkling-2-Mini-UD-Q4_K_M.gguf"; DEF_BACKEND=vulkan; PORT=18088
           # Measured 2026-11-25 on the B65, 7.1K-token prompt (llama.cpp 36d818e):
           #   Vulkan          376 tok/s prompt, 19.2 tok/s generation
           #   Vulkan + DSpark 325 tok/s prompt, 12.4 tok/s (~48 % of drafts accepted) -> slower
           #   SYCL             53 tok/s prompt,  3.7 tok/s (graph split into 290 parts, ops fall back to CPU)
           CTX=65536   # native max is 1M; raise once VRAM use on the B65 is known
           # Thinking Machines Inkling 2 Mini (MoE 26.4B / 3.4B active, looped middle layers).
           # Unsloth "Mainline_Support" GGUF (needs llama.cpp with #32704). Not for Czech.
           # Reasoning cannot be fully disabled and can loop while debugging -> cap the output
           # per request (-n) so a runaway answer ends on its own.
           SAMPLING=(--temp 1.0 --top-p 1.0 --top-k 0 --min-p 0 -n 16384)
           # SYCL only: -ub 2048 needs a ~27.5 GB compute buffer on this model (looped layers, 200k vocab).
           UBATCH=512
           # DSpark drafter (llama.cpp #32218): opt-in with DSPARK=1, it slows the B65 down (see above).
           MTP="$MODELS/dspark-Inkling-2-Mini-Q8_0.gguf"
           if [ -f "$MTP" ] && [ -n "${DSPARK:-}" ]; then
               SAMPLING+=(--spec-type draft-dspark --spec-draft-model "$MTP" --spec-draft-n-max 3
                          --spec-draft-sampling probabilistic)
           fi ;;
    *)     MODEL="$1"; DEF_BACKEND=vulkan; PORT=18080; CTX=65536; SAMPLING=() ;;
esac
# Vision projector: without it llama-server rejects image input
# ("image input is not supported"), e.g. GIMP MCP get_state_snapshot. Disable with NO_MMPROJ=1.
case "${1:-qwen-oc}" in
    qwen|qwen-oc) MMPROJ="$MODELS/mmproj/mmproj-Qwen3.8-27B-F16.gguf"
           if [ -f "$MMPROJ" ] && [ -z "${NO_MMPROJ:-}" ]; then SAMPLING+=(--mmproj "$MMPROJ"); fi ;;
esac
[ $# -gt 0 ] && shift
BACKEND="${BACKEND:-$DEF_BACKEND}"

if [ "$BACKEND" = sycl ]; then
    # oneAPI runtime libraries (setvars.sh trips over `set -u`).
    set +u; source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1 || true; set -u
    BIN="$SRC/build-sycl-dnn/bin/llama-server"
    PATTERN='Arc'
    FA=on
    # Larger micro-batch: prompt processing ~+50 % on SYCL (490 -> 730 tok/s on Qwen).
    BATCH=(-b 2048 -ub "${UBATCH:-2048}")
else
    BIN="$SRC/build-vulkan/bin/llama-server"
    PATTERN='BMG'
    FA=off   # on Vulkan, flash attention makes prompt processing ~3x slower
    BATCH=() # larger micro-batch gains only ~5 % on Vulkan
fi

# Device order changes between boots -> resolve the B65 by name.
DEV=$("$BIN" --list-devices 2>/dev/null | awk -F: -v p="$PATTERN" '$0 ~ p {gsub(/ /,"",$1); print $1; exit}')
if [ -z "$DEV" ]; then
    echo "B65 not found by the $BACKEND backend - is the eGPU box connected? (boltctl list)" >&2
    [ "$BACKEND" = sycl ] && echo "SYCL needs full Resizable BAR: reboot with the box attached, or use BACKEND=vulkan." >&2
    exit 1
fi
echo "B65 = $DEV ($BACKEND), port $PORT, model = $MODEL" >&2

exec "$BIN" -m "$MODEL" --device "$DEV" -ngl 99 \
    --jinja -fa "$FA" -np 1 -c "$CTX" "${BATCH[@]}" "${SAMPLING[@]}" \
    --host 127.0.0.1 --port "$PORT" "$@"
