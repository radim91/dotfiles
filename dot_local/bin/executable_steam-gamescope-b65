#!/bin/sh
# steam-gamescope-b65 — spouštěč Steamu uvnitř gamescope relace (gamescope-session-plus).
#
# gamescope-session-plus spouští klienta přes `switcherooctl launch`, který bez -g
# vybere první diskrétní GPU = NVIDIA RTX PRO 1000 a nastaví PRIME offload na ni.
# Tady to zrušíme a všechno (Steam UI, Proton/DXVK/VKD3D, nativní GL/Vulkan hry)
# pošleme na eGPU Arc Pro B65 (8086:e222). Vendor:device ID místo PCI cesty,
# protože PCI adresa eGPU se po hot-plugu může změnit.
#
# Pro GNOME relaci dál slouží `egpu-b65`; tenhle skript je jen pro gamescope relaci.

exec env \
  -u __NV_PRIME_RENDER_OFFLOAD \
  -u __GLX_VENDOR_LIBRARY_NAME \
  -u __VK_LAYER_NV_optimus \
  VK_LOADER_DRIVERS_SELECT='*intel_icd*' \
  MESA_VK_DEVICE_SELECT='8086:e222!' \
  DRI_PRIME='8086:e222' \
  steam "$@"
